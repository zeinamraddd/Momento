PORT=3000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=your_mongodb_connection_string
SESSION_SECRET=replace_with_a_long_random_hex_string_at_least_32_characters
NODE_ENV=development
# Change to true ONLY for HTTPS deployments where frontend and API are on different sites.
COOKIE_CROSS_SITE=false

# Forgot-password email delivery (configure in your local .env / hosting dashboard).
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Momento <no-reply@example.com>
